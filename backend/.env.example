# ========================================================
# AK Cars - Backend Environment Configuration Template
# Copy this file to .env and adjust variables as needed
# ========================================================

# PostgreSQL Connection String
# Format: postgresql://username:password@localhost:5432/ak_cars_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ak_cars

# Application Security Secret
SECRET_KEY=ak_cars_super_secure_random_production_secret_key_2026

# Uploads Storage Path (Defaults to backend/uploads)
UPLOAD_DIR=./backend/uploads

# Allowed Frontend Origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
